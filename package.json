{
  "name": "trilara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 -p 3002",
    "dev:rede": "next dev --webpack --hostname 0.0.0.0 --port 3002",
    "build": "next build",
    "brand:og": "node scripts/gerar-og-trilara.cjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "perf:local": "tsx scripts/medir-desempenho.ts",
    "db:up": "docker compose up -d",
    "db:up:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/iniciar-postgres-local.ps1",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "colaborador": "tsx scripts/criar-colaborador.ts",
    "senha:local": "tsx scripts/gerar-link-senha-local.ts",
    "demo:documentos": "tsx scripts/seed-documentos-demo.ts",
    "admin:proteger": "tsx scripts/proteger-admin.ts",
    "start:local": "next start -H 127.0.0.1 -p 3002",
    "local:rapido": "npm run build && npm run start:local",
    "test:permissoes": "tsx scripts/testar-permissoes.ts",
    "test:solicitacoes": "tsx scripts/testar-solicitacoes-acesso.ts",
    "test:antivirus": "tsx scripts/verificar-antivirus-pdf.ts",
    "test:seguranca:http": "node scripts/testar-seguranca-http.mjs",
    "test:seguranca:conteudo": "tsx scripts/testar-seguranca-conteudo.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.47.0",
    "next": "16.4.5",
    "nodemailer": "^10.1.4",
    "pdfjs-dist": "^5.4.449",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^2.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.1"
  }
}
