# Banco local de desenvolvimento.
DATABASE_URL=postgresql://trilara:trilara_dev@127.0.0.1:5435/trilara?schema=public
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-uma-chave-aleatoria-de-64-caracteres
# Opcional: armazenamento privado de documentos.
DOCS_STORAGE_DIR=
AWS_REGION=sa-east-1
S3_BUCKET_DOCUMENTOS=
# Em produção, uploads de PDF exigem ClamAV mesmo se PDF_SCAN_REQUIRED não estiver definido.
PDF_ANTIVIRUS_SOCKET=
PDF_SCAN_REQUIRED=true
# Habilite só com Next em 127.0.0.1 e proxy que sobrescreva X-Real-IP.
RATE_LIMIT_TRUST_PROXY=false
# Opcional: recuperação de senha.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RESET_EMAIL_FROM=Trilara <naoresponder@exemplo.com>
RESET_BASE_URL=http://localhost:3002
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Opcional: email do admin que pode consultar custos do assistente.
NEXT_PUBLIC_ASSISTENTE_ADMIN_EMAIL=
# Opcional: provedores de IA.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
OPENROUTER_API_KEY=
